{
  "mcpServers": {
    "lark": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@larksuiteoapi/lark-mcp@0.5.1",
        "mcp",
        "-a",
        "${LARK_APP_ID}",
        "-s",
        "${LARK_APP_SECRET}",
        "-d",
        "https://open.larksuite.com",
        "--oauth",
        "--token-mode",
        "user_access_token",
        "--scope",
        "docx:document wiki:wiki drive:drive offline_access board:whiteboard:node:read board:whiteboard:node:create board:whiteboard:node:update",
        "-t",
        "preset.doc.default,docx.v1.document.get,docx.v1.documentBlock.get,docx.v1.documentBlock.list,docx.v1.documentBlockChildren.get,docx.v1.document.create,docx.v1.documentBlockChildren.create,docx.v1.documentBlockDescendant.create,docx.v1.documentBlock.batchUpdate,docx.v1.documentBlock.patch,docx.v1.documentBlockChildren.batchDelete,wiki.v2.spaceNode.create,drive.v1.file.list,drive.v1.media.batchGetTmpDownloadUrl,board.v1.whiteboardNode.list",
        "-l",
        "en"
      ]
    }
  }
}